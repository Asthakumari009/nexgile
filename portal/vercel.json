{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/portal/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nexgile-uftk.onrender.com/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://nexgile-uftk.onrender.com/storage/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
